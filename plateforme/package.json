{
  "name": "@guacamole/plateforme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:sqlite": "PLATEFORME_BASE=sqlite vitest run",
    "test:postgres": "PLATEFORME_BASE=postgres vitest run",
    "typecheck": "tsc --noEmit",
