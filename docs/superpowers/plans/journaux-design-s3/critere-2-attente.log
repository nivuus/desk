########## 2bfc2b6 — design(s3): la mitigation du re-étiquetage, que S2 déclarait impossible ##########
diff --git a/client/outils/tokens-orphelins/attente.mjs b/client/outils/tokens-orphelins/attente.mjs
index e21223b..4fe0481 100644
--- a/client/outils/tokens-orphelins/attente.mjs
+++ b/client/outils/tokens-orphelins/attente.mjs
