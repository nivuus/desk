# Gabarit de `deploiement/postgres.env` — l'instance Postgres du DÉPLOIEMENT.
#
# 🔴 COPIER CE FICHIER EN `deploiement/postgres.env` ET Y METTRE DE VRAIES
# VALEURS. Le fichier `postgres.env` est ignoré par git (`.gitignore`) ; ce
# gabarit-ci est versionné et ne doit JAMAIS porter de valeur réelle.
#
# Sans lui, `docker compose -f docker-compose.plateforme.yml --profile
# deploiement up -d` échoue en le nommant — et la commande SANS profil, celle
# de la suite de tests, reste intacte.

POSTGRES_USER=<le compte, par exemple plateforme>
POSTGRES_DB=<le nom de la base, par exemple plateforme>

# 🔴 TIRÉ AU SORT, jamais choisi à la main :
#     openssl rand -base64 32
POSTGRES_PASSWORD=<généré>
