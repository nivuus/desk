# Unite systemd du service desk (bureau distant Windows, WebRTC).
#
# Deposee par hooks/install.py sous etc/systemd/system/desk-plateforme.service.
# 🔴 CE FICHIER EST UN GABARIT DEPUIS LE LOT 10A (29 aout 2026, probleme A) :
# un seul jeton (deux occurrences ci-dessous, dans ExecStart= et dans
# Environment=PATH=) est remplace TEXTUELLEMENT par `hooks/install.py::main()`
# avec la valeur de `commun.lire_node_bin()` — jamais une expansion de
# variable systemd (systemd n'expanse pas le PROGRAMME execute lui-meme,
# seulement ses arguments). ⚠️ CE TOKEN EST DELIBEREMENT ABSENT DE CE
# COMMENTAIRE DE TETE, alors qu'il apparait litteralement plus bas : la
# substitution d'install.py est un remplacement de SOUS-CHAINE global sur
# tout le fichier, et l'ecrire ici aussi le ferait remplacer dans le
# commentaire lui-meme (mesure une fois, corrige — voir git blame). Le
# nommer par sa valeur : chercher `NODE_BIN_DEFAUT` dans commun.py. Les
# trois AUTRES chemins (WorkingDirectory, EnvironmentFile, et le chemin
# substitue plus bas) sont les chemins REELS de la cible une fois
# l'installation terminee (root == "/"), jamais prefixes par la racine
# temporaire qu'un test pose sous --root.
#
# 🔴 POSEE, PAS ARMEE. install ne fait que deposer ce fichier — ni
# `systemctl daemon-reload`, ni `enable`, ni `start`. C'est la tache 5
# (activate) qui l'arme, par un LIEN vers cette unite (jamais un
# `systemctl enable`, qui echoue en silence dans un environnement
# contraint). Meme doctrine que console/hooks/install.py pour ses unites de
# reveil : « Placed, deliberately NOT enabled ... The activate phase arms
# them ».
[Unit]
Description=Plateforme desk (bureau distant Windows, WebRTC) - paquet Nivuus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nivuus/desk/plateforme

# 🔴 IL N'Y A AUCUN `npm` SYSTEME SUR CETTE MACHINE (ni paquet Debian, ni
# NodeSource) — voir commun.py::lire_node_bin pour le diagnostic complet.
# Le jeton ci-dessous est substitue par install.py vers le repertoire ou ce
# lot deploie une copie de Node lisible par tous (a+rX), par defaut
# /opt/nivuus/node/bin (commun.NODE_BIN_DEFAUT), surchargeable par
# DESK_NODE_BIN.
ExecStart=__NODE_BIN__/npm start

# 🔴 OBLIGATOIRE EN PLUS DE ExecStart= : `npm` lui-meme est un script
# `#!/usr/bin/env node` — le noyau resout `node` en cherchant dans PATH au
# moment ou il execute le shebang, meme si `npm` est invoque par un chemin
# absolu. Et `npm start` (= `tsx src/index.ts`) spawn a son tour
# `node_modules/.bin/tsx`, un AUTRE script `#!/usr/bin/env node`, dont la
# resolution repasse par CE MEME PATH (npm ne fait que prefixer
# node_modules/.bin devant la valeur heritee). Sans cette ligne, l'unite
# echouerait a l'exec meme avec ExecStart= correct.
Environment=PATH=__NODE_BIN__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

EnvironmentFile=/etc/nivuus/desk.env
Restart=on-failure
RestartSec=5

# Un utilisateur DEDIE, sans provisioning a la charge de ce hook : c'est
# precisement ce que `DynamicUser=yes` offre — systemd cree et detruit un
# UID/GID ephemere a chaque demarrage/arret, sans `useradd` ni entree
# durable dans /etc/passwd. `StateDirectory=nivuus-desk` fait creer et
# posseder /var/lib/nivuus-desk par ce meme utilisateur a chaque demarrage
# — c'est la ou PLATEFORME_BASE_URL (voir desk.env) range son fichier
# SQLite, pour que le service garde son etat d'un redemarrage a l'autre
# plutot que de retomber sur `:memory:`.
DynamicUser=yes
StateDirectory=nivuus-desk
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
